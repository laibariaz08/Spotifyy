<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    >

    <!-- Back button at the top left corner -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginLeft="19dp"
        android:src="@drawable/arrow_head"
        android:contentDescription="Back"
        android:layout_gravity="top|start"/>

    <!-- Search prompt text at the top center -->
    <EditText
        android:id="@+id/searchPrompt"
        android:layout_width="330dp"
        android:layout_height="32dp"
        android:text="     Search Your Library"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:layout_marginLeft="28dp"
        android:background="#808080"
        android:alpha="0.8"/>

    <!-- Centralized main text and description -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/mainText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find your favorites"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search everything you've saved, followed, or\n                                created."
            android:textColor="#B3B3B3"
            android:textSize="16sp"/>
    </LinearLayout>

</FrameLayout>
